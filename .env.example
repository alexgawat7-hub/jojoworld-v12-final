# Copy this file to .env locally, or set these as environment variables in your hosting provider.
# Never commit real tokens, passwords, or payment secrets.

# Required for Facebook Messenger webhook verification and replies
META_APP_SECRET=replace_with_meta_app_secret
PAGE_TOKEN=replace_with_facebook_page_access_token
VERIFY_TOKEN=replace_with_a_long_random_webhook_verify_token
PORT=10000

# Recommended for persistent user wallets and account data
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/YOUR_DATABASE

# Required for PayMongo top-ups and signed payment webhooks
PAYMONGO_SECRET=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me

# Optional settings
ADMIN_ID=replace_with_admin_messenger_psid
GCASH_NUM=replace_with_admin_gcash_number
PAGE_USERNAME=your_messenger_page_username

# Optional AI-generated name-effect artwork (uses OpenAI API; billed separately from ChatGPT)
# Add this secret to Render Environment after creating an OpenAI API key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=low
